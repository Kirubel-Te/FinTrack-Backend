# Copy to .env and fill required values for local development or Render deployment
# Use Render's internal database URL for the backend service running on Render.
# Use the external database URL only for local development or tools outside Render.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
CORS_ORIGIN=http://localhost:5173
PORT=3000
NODE_ENV=development
JWT_SECRET=replace_this_with_a_strong_secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace_this_with_a_strong_secret
JWT_REFRESH_EXPIRES_IN=7d
REFRESH_TOKEN_TTL_DAYS=7
